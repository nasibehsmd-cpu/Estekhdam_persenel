<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>پنل پرسنل | انتخاب نیک</title>

    <link rel="stylesheet" href="worker.css">
</head>

<body>

    <div class="worker-page">

        <!-- هدر پنل -->
        <header class="worker-header">

            <div class="worker-logo">
                <div class="logo-icon">ن</div>

                <div>
                    <h1>انتخاب نیک</h1>
                    <span>پنل پرسنل</span>
                </div>
            </div>

            <button type="button" class="logout-button" id="logoutButton">
                خروج
            </button>

        </header>


        <!-- محتوای اصلی -->
        <main class="worker-main">

            <section class="welcome-section">

                <span class="section-label">
                    پنل اختصاصی پرسنل
                </span>

                <h2 id="workerWelcome">
                    خوش آمدید
                </h2>

                <p>
                    اطلاعات و کارهای شما در این پنل نمایش داده می‌شود.
                </p>

            </section>


            <!-- کارت‌های اصلی پنل -->
            <section class="worker-menu">

                <button class="menu-card" data-section="profile">
                    <span class="menu-icon">👤</span>
                    <span>اطلاعات من</span>
                </button>

                <button class="menu-card" data-section="jobs">
                    <span class="menu-icon">🧹</span>
                    <span>کارهای من</span>
                </button>

                <button class="menu-card" data-section="account">
                    <span class="menu-icon">💰</span>
                    <span>حساب من</span>
                </button>

                <button class="menu-card" data-section="payment">
                    <span class="menu-icon">💳</span>
                    <span>واریز به شرکت</span>
                </button>

                <button class="menu-card" data-section="message">
                    <span class="menu-icon">💬</span>
                    <span>پیام به شرکت</span>
                </button>

                <button class="menu-card" data-section="training">
                    <span class="menu-icon">📚</span>
                    <span>آموزش و نحوه انجام کار</span>
                </button>

                <button class="menu-card" data-section="rules">
                    <span class="menu-icon">📋</span>
                    <span>قوانین همکاری</span>
                </button>

                <button class="menu-card" data-section="announcements">
                    <span class="menu-icon">📢</span>
                    <span>اطلاعیه‌ها</span>
                </button>

            </section>


            <!-- محل نمایش بخش‌های پنل -->
            <section class="worker-content" id="workerContent">

                <div class="content-placeholder">

                    <div class="placeholder-icon">👤</div>

                    <h3>
                        پنل پرسنل
                    </h3>

                    <p>
                        برای مشاهده اطلاعات، یکی از بخش‌های بالا را انتخاب کنید.
                    </p>

                </div>

            </section>

        </main>


        <!-- فوتر -->
        <footer class="worker-footer">

            <strong>
                شرکت خدماتی نظافتی تبریز انتخاب نیک
            </strong>

            <span>
                پنل اختصاصی پرسنل
            </span>

        </footer>

    </div>


    <script src="js/worker.js"></script>

</body>
</html><!-- بخش‌های پنل -->

<section class="panel-section" id="profileSection">
    <div class="section-header">
        <span class="section-icon">👤</span>
        <div>
            <h3>اطلاعات من</h3>
            <p>اطلاعات ثبت‌شده شما در شرکت</p>
        </div>
    </div>

    <div class="info-grid">
        <div class="info-item">
            <span>نام و نام خانوادگی</span>
            <strong id="workerName">---</strong>
        </div>

        <div class="info-item">
            <span>کد پیگیری</span>
            <strong id="workerCode">---</strong>
        </div>

        <div class="info-item">
            <span>شماره موبایل</span>
            <strong id="workerPhone">---</strong>
        </div>

        <div class="info-item">
            <span>آدرس</span>
            <strong id="workerAddress">---</strong>
        </div>

        <div class="info-item">
            <span>وضعیت همکاری</span>
            <strong id="workerStatus">---</strong>
        </div>

        <div class="info-item">
            <span>تاریخ شروع همکاری</span>
            <strong id="workerStartDate">---</strong>
        </div>
    </div>
</section>


<section class="panel-section" id="jobsSection">

    <div class="section-header">
        <span class="section-icon">🧹</span>
        <div>
            <h3>کارهای من</h3>
            <p>کارهای ثبت‌شده برای شما</p>
        </div>
    </div>

    <div class="jobs-container" id="jobsContainer">

        <div class="empty-state">
            <span>🧹</span>
            <p>هنوز کاری برای شما ثبت نشده است.</p>
        </div>

    </div>

</section>


<section class="panel-section" id="accountSection">

    <div class="section-header">
        <span class="section-icon">💰</span>
        <div>
            <h3>حساب من</h3>
            <p>مبالغ مربوط به کارهای شما</p>
        </div>
    </div>

    <div class="account-box">

        <div class="account-item">
            <span>مبلغ حساب</span>
            <strong id="workerAccount">---</strong>
        </div>

    </div>

</section>


<section class="panel-section" id="paymentSection">

    <div class="section-header">
        <span class="section-icon">💳</span>
        <div>
            <h3>واریز به شرکت</h3>
            <p>اطلاعات حساب شرکت برای واریز</p>
        </div>
    </div>

    <div class="payment-box">

        <p>
            در صورت نیاز به واریز وجه به شرکت،
            اطلاعات پرداخت از این قسمت در اختیار شما قرار می‌گیرد.
        </p>

            <div id="companyPaymentInfo">

                <div class="payment-card">
                    <strong>💳 شماره کارت</strong>
                    <div style="font-size:20px !important; font-weight:700 !important;">۶۲۱۹۸۶۱۰۳۲۱۴۸۸۶۷</div>
                    <div>بانک: سامان &nbsp;&nbsp;&nbsp; به نام: احمد روحی</div>
                </div>

                <div class="payment-card">
                    <strong>💳 شماره کارت</strong>
                    <div style="font-size:20px !important; font-weight:700 !important;">۶۲۸۰۲۳۱۴۵۹۴۱۰۰۰۶</div>
                    <div>بانک: مسکن &nbsp;&nbsp;&nbsp; به نام: صمدی</div>
                </div>

            </div>

    </div>

</section>


<section class="panel-section" id="messageSection">

    <div class="section-header">
        <span class="section-icon">💬</span>
        <div>
            <h3>پیام به شرکت</h3>
            <p>ارسال پیام و درخواست به شرکت</p>
        </div>
    </div>

    <form id="messageForm">

        <textarea
            id="workerMessage"
            placeholder="پیام خود را بنویسید..."
            rows="5"
            required
        ></textarea>

        <div class="receipt-upload">
            <label for="receiptImage">
                📷 ارسال عکس رسید واریز
            </label>

            <input
                type="file"
                id="receiptImage"
                accept="image/*"
            >

            <div id="receiptPreview"></div>
        </div>

        <button type="submit" class="submit-message">
            ارسال پیام
        </button>

        <div id="messageResult"></div>

    </form>

</section><section class="panel-section" id="trainingSection">

    <div class="section-header">
        <span class="section-icon">📚</span>
        <div>
            <h3>آموزش و نحوه انجام کار</h3>
            <p>راهنمای انجام صحیح خدمات</p>
        </div>
    </div>

    <div class="training-list">

        <details class="training-item">
            <summary>نظافت راه‌پله</summary>

            <div class="training-content">

                <h4>ترتیب نظافت راه‌پله</h4>

                <ol>
                    <li>
                        ابتدا از راهرو پشت‌بام شروع به جارو کردن می‌کنیم.
                        سپس به پایین می‌آییم و پارکینگ و حیاط را هم جارو می‌زنیم.
                        چون اگر بدون جارو کردن شستشو انجام شود و فاضلاب گرفته شود،
                        خسارت آن بر عهده شما خواهد بود. بنابراین جارو کردن بسیار مهم است.
                    </li>

                    <li>
                        یک سطل آب برداشته، با طی نخی، شیشه‌پاک‌کن و چند دستمال
                        به طبقه بالا می‌رویم. کپسول آتش‌نشانی، نرده‌ها، شیشه‌ها
                        و کلید و پریزها را پاک می‌کنیم. کابین آسانسور را تمیز می‌کنیم
                        و بعد از آن، طی هر طبقه را می‌کشیم و به طبقات پایین‌تر می‌آییم.
                    </li>

                    <li>
                        هر چند طبقه یک‌بار سطل آب را عوض می‌کنیم.
                    </li>

                    <li>
                        وقتی به پارکینگ رسیدیم، تاید می‌ریزیم و بعد از شستشو
                        با طی مویی، با طی پلاستیکی آب را جمع می‌کنیم تا آب داخل
                        پارکینگ باقی نماند.
                    </li>

                    <li>
                        حیاط اگر آشغال داشت، جمع می‌کنیم و بعد از جارو زدن حیاط،
                        آن را می‌شوییم.
                    </li>

                    <li>
                        حتماً درب خروجی‌های پارکینگ را می‌شوییم و مراقب باشید
                        که به وسایل برقی آب نپاشید؛ مانند آسانسور، آی‌فون یا ریموت
                        پارکینگ. بعد از شستشو، درب‌ها را حتماً با دستمال خشک کنید
                        تا لکه‌ای به جا نماند.
                    </li>

                    <li>
                        هنگام خروج، حتماً کارمان را به نماینده یا یکی از همسایه‌ها
                        تحویل دهید تا بعداً مشکلی پیش نیاید.
                    </li>

                    <li>
                        اگر از آپارتمان آشغال جمع کردید، آن‌ها را به بیرون منتقل کنید.
                    </li>

                    <li>
                        به هیچ‌وجه در واحد کسی را نزنید، مگر از آیفون خیابان.
                    </li>
                </ol>

            </div>
        </details>


        <details class="training-item">
            <summary>نظافت منزل</summary>

            <div class="training-content">

                <h4>مراحل نظافت منزل</h4>

                <ol>
                    <li>
                        <strong>آماده‌سازی و جمع‌آوری اولیه:</strong>
                        وسایل و خرده‌ریزهای اضافی را مرتب و جمع‌آوری کنید.
                        زباله‌ها را جمع کرده و داخل کیسه زباله قرار دهید.
                        قبل از شروع کار، وسایل موردنیاز و مواد شوینده را آماده کنید.
                    </li>

                    <li>
                        <strong>گردگیری منزل:</strong>
                        گردگیری از قسمت‌های بالاتر به سمت پایین انجام شود.
                        طاقچه‌ها، میزها، کمدها، قفسه‌ها و سایر سطوح گردگیری شوند.
                        دستگیره درها، کلید و پریزها و چهارچوب‌ها تمیز شوند.
                        وسایل تزئینی و سطوح حساس با دستمال مناسب تمیز شوند.
                    </li>

                    <li>
                        <strong>نظافت اتاق‌ها و پذیرایی:</strong>
                        میزها، صندلی‌ها و سایر وسایل تمیز شوند.
                        زیر و اطراف وسایل تا حد امکان جارو شود.
                        شیشه‌ها و آینه‌های موجود تمیز شوند.
                        کوسن‌ها و وسایل قابل جابه‌جایی مرتب شوند.
                    </li>

                    <li>
                        <strong>آشپزخانه:</strong>
                        سینک و شیرآلات کاملاً شسته و تمیز شوند.
                        سطح کابینت‌ها و دستگیره‌ها دستمال‌کشی شوند.
                        اجاق گاز و قسمت‌های قابل شستشوی هود تمیز شوند.
                        میز و سطح کار آشپزخانه تمیز شود.
                        در صورت درخواست مشتری، داخل کابینت یا یخچال نیز نظافت شود.
                    </li>

                    <li>
                        <strong>سرویس بهداشتی و حمام:</strong>
                        توالت، روشویی و کف شسته و تمیز شوند.
                        آینه و شیرآلات تمیز شوند.
                        لکه‌ها و جرم‌های قابل مشاهده برطرف شوند.
                        در پایان، کف کاملاً خشک شود.
                    </li>

                    <li>
                        <strong>نظافت شیشه و پنجره‌ها:</strong>
                        شیشه‌ها با شیشه‌پاک‌کن و دستمال یا تی مخصوص تمیز شوند.
                        قاب و لبه پنجره‌ها نیز دستمال‌کشی شوند.
                        بعد از شستشو، شیشه‌ها خشک و بدون لکه تحویل داده شوند.
                    </li>

                    <li>
                        <strong>جارو و نظافت کف:</strong>
                        تمام اتاق‌ها، پذیرایی، راهرو و آشپزخانه به‌طور کامل جارو شوند.
                        بعد از جارو، کف‌های قابل شستشو با شوینده مناسب طی کشیده شوند.
                        آب اضافی جمع شود و کف تا حد امکان خشک تحویل داده شود.
                    </li>

                    <li>
                        <strong>بالکن و تراس، در صورت وجود:</strong>
                        آشغال‌ها و گرد و خاک جمع شوند.
                        کف جارو و در صورت نیاز شسته شود.
                        نرده‌ها و قسمت‌های قابل دسترس دستمال‌کشی شوند.
                    </li>
                </ol>

                <h4>⚠️ نکات مهم</h4>

                <ul>
                    <li>اول جمع‌آوری و گردگیری، بعد جارو و در آخر شستشوی کف انجام شود.</li>
                    <li>برای هر سطح از شوینده مناسب همان سطح استفاده شود.</li>
                    <li>مواد شوینده را با یکدیگر مخلوط نکنید؛ مخصوصاً وایتکس را با جوهرنمک یا سایر شوینده‌های اسیدی مخلوط نکنید.</li>
                    <li>وسایل برقی مانند تلویزیون، کامپیوتر و وسایل آشپزخانه مستقیماً با آب شسته نشوند.</li>
                    <li>هنگام نظافت وسایل مشتری، با دقت و احتیاط کار کنید.</li>
                    <li>در پایان کار، یک دور کامل منزل بررسی شود تا چیزی از قلم نیفتاده باشد.</li>
                    <li>منزل باید تمیز، مرتب و بدون لکه آب تحویل مشتری شود.</li>
                </ul>

            </div>
        </details>


        <details class="training-item">
            <summary>نظافت واحد خالی</summary>

            <div class="training-content">

                <h4>🏠 مراحل نظافت واحد خالی</h4>

                <ol>
                    <li>
                        <strong>جمع‌آوری گرد و خاک و زباله‌ها:</strong>
                        ابتدا تمام زباله‌ها و گرد و خاک جمع‌آوری شود و کف واحد
                        به‌طور کامل با جارو دستی یا جاروبرقی جارو شود.
                    </li>

                    <li>
                        <strong>گردگیری سطوح:</strong>
                        طاقچه‌ها، پنجره‌ها، کمدها و کابینت‌ها گردگیری و دستمال‌کشی شوند.
                        کلید و پریزها، درب‌ها و چهارچوب‌ها نیز تمیز شوند.
                    </li>

                    <li>
                        <strong>نظافت شیشه‌ها و پنجره‌ها:</strong>
                        شیشه‌ها با شیشه‌پاک‌کن و دستمال یا تی مخصوص شیشه تمیز شوند.
                        لبه‌ها و قاب پنجره‌ها نیز دستمال‌کشی شوند.
                    </li>

                    <li>
                        <strong>نظافت کابینت‌ها و کمدها:</strong>
                        داخل و بیرون کابینت‌ها و کمدها با دستمال و شوینده ملایم تمیز شوند.
                        بعد از شستشو حتماً خشک شوند.
                    </li>

                    <li>
                        <strong>تمیز کردن دیوارهای قابل شستشو:</strong>
                        لکه‌ها با دستمال مرطوب یا اسفنج تمیز شوند.
                        در صورت نیاز از شوینده رقیق استفاده شود.
                    </li>

                    <li>
                        <strong>سرویس بهداشتی و حمام:</strong>
                        سرویس و حمام شستشو و ضدعفونی شوند.
                        شیرآلات با جرم‌گیر مخصوص تمیز شوند.
                        کف سرویس و حمام با برس و شوینده مناسب شسته شود.
                    </li>

                    <li>
                        <strong>آشپزخانه:</strong>
                        سینک با شوینده مناسب شسته شود.
                        گاز و هود، در صورت وجود، دستمال‌کشی و تمیز شوند.
                    </li>

                    <li>
                        <strong>نظافت کف واحد:</strong>
                        بعد از جارو، کف با طی نخی و شوینده مناسب شسته شود.
                        سپس آب کاملاً با طی پلاستیکی یا خشک‌کن جمع شود تا کف لکه‌دار نماند.
                    </li>

                    <li>
                        <strong>درب ورودی و تراس یا بالکن:</strong>
                        درب ورودی و قسمت‌های قابل شستشو تمیز و دستمال‌کشی شوند.
                        آشغال و گرد و خاک تراس یا بالکن نیز جمع شود.
                    </li>
                </ol>

                <h4>⚠️ نکات مهم</h4>

                <ul>
                    <li>اول جارو و گردگیری، بعد شستشو انجام شود.</li>
                    <li>مواد شوینده قوی فقط در محل مناسب و طبق دستور استفاده شوند.</li>
                    <li>مواد شوینده را با یکدیگر مخلوط نکنید؛ مخصوصاً وایتکس را با جوهرنمک یا شوینده‌های اسیدی مخلوط نکنید.</li>
                    <li>بعد از شستشو حتماً خشک‌کنی انجام شود تا لکه آب باقی نماند.</li>
                </ul>

            </div>
        </details>


        <details class="training-item">
            <summary>نظافت اداره</summary>

            <div class="training-content">

                <h4>🏢 مراحل نظافت شرکت‌ها و ادارات</h4>

                <ol>

                    <li>
                        <strong>گردگیری و پاکسازی اولیه:</strong>
                        تمام سطوح شامل میزها، صندلی‌ها، کمدها و قفسه‌ها گردگیری شوند.
                        پنجره‌ها، شیشه‌ها و پرده‌ها تمیز شوند.
                        تجهیزات الکترونیکی مانند کامپیوتر، مانیتور و تلفن
                        با دستمال مناسب و ضدخش تمیز شوند.
                    </li>

                    <li>
                        <strong>نظافت کف:</strong>
                        تمام کف‌ها و راهروها به‌طور کامل جارو شوند.
                        سپس با مواد شوینده مناسب طی کشیده و شسته شوند.
                        در صورت نیاز بهداشتی، از مواد ضدعفونی‌کننده مناسب استفاده شود.
                        زباله‌ها جمع‌آوری و کیسه‌های سطل‌های زباله تعویض شوند.
                    </li>

                    <li>
                        <strong>سرویس‌های بهداشتی:</strong>
                        توالت‌ها و دستشویی‌ها کاملاً شسته و تمیز شوند.
                        روشویی‌ها، آینه‌ها و شیرآلات تمیز شوند.
                        مایع دستشویی و دستمال کاغذی در صورت نیاز شارژ شوند.
                        محیط تمیز و مرتب و در صورت امکان خوشبو نگه داشته شود.
                    </li>

                    <li>
                        <strong>آشپزخانه یا آبدارخانه:</strong>
                        لیوان‌ها، ظروف و سینی‌ها شسته و تمیز شوند.
                        سینک، شیرآلات و پیشخوان نظافت شوند.
                        یخچال، کتری و وسایل برقی مشترک در صورت درخواست تمیز شوند.
                        زباله‌ها جمع‌آوری و سطل‌ها تمیز شوند.
                    </li>

                    <li>
                        <strong>اتاق جلسات و فضاهای عمومی:</strong>
                        میز کنفرانس و صندلی‌ها گردگیری و تمیز شوند.
                        صندلی‌ها مرتب و منظم قرار داده شوند.
                        تجهیزات صوتی و تصویری با دقت و دستمال مناسب تمیز شوند.
                        کف و پنجره‌های اتاق جلسات و فضاهای عمومی نیز نظافت شوند.
                    </li>

                    <li>
                        <strong>ضدعفونی و بهداشت عمومی:</strong>
                        سطوح پرتماس مانند دستگیره‌ها، کلیدهای برق و دکمه‌های آسانسور
                        به‌صورت منظم تمیز و ضدعفونی شوند.
                        محیط به‌خوبی تهویه شود و از مواد بهداشتی استاندارد و مطمئن استفاده شود.
                    </li>

                </ol>

                <h4>⚠️ نکات مهم</h4>

                <ul>
                    <li>ابتدا گردگیری و جمع‌آوری زباله انجام شود، سپس جارو و شستشوی کف.</li>
                    <li>برای تجهیزات الکترونیکی از دستمال مناسب استفاده شود و آب مستقیماً روی آن‌ها ریخته نشود.</li>
                    <li>مواد شوینده را با یکدیگر مخلوط نکنید.</li>
                    <li>بعد از شستشوی کف، آب اضافی کاملاً جمع و کف خشک شود.</li>
                    <li>در پایان کار، تمام قسمت‌های محل یک‌بار بررسی شود تا چیزی از قلم نیفتاده باشد.</li>
                </ul>

            </div>
        </details>

    </div>

</section>


<section class="panel-section" id="rulesSection">

    <div class="section-header">
        <span class="section-icon">📋</span>
        <div>
            <h3>قوانین همکاری</h3>
            <p>قوانین و شرایط همکاری با شرکت</p>
        </div>
    </div>

    <div class="rules-box">

        <div class="rule-item">
            <span>1️⃣</span>
            <p>
                <strong>تعهد به انجام کار:</strong>
                در صورت قبول کردن کار و حاضر نشدن در محل، مبلغ درصد توافقی به عنوان جریمه از کارگر دریافت میشود.
                بار اول: کسر درصد به عنوان جریمه.
                بار دوم: دریافت کل مبلغ کار به عنوان جریمه.
                بار سوم: قطع کامل همکاری با شرکت.
            </p>
        </div>

        <div class="rule-item">
            <span>2️⃣</span>
            <p>
                <strong>نحوه پرداخت مشتری:</strong>
                در ۹۰٪ موارد، مشتری هزینه را مستقیماً به نظافتچی پرداخت میکند.
                در ۱۰٪ موارد، یا مشتری خودش تمایل دارد مبلغ را به شرکت پرداخت کند، یا شرکت از مشتری میخواهد مستقیم به حساب شرکت واریز نماید.
                در هر حالت، پرسنل حق هیچگونه بحث یا اعتراض با مشتری در خصوص نحوه پرداخت ندارند.
            </p>
        </div>

        <div class="rule-item">
            <span>3️⃣</span>
            <p>
                <strong>تسویه حساب روزانه:</strong>
                تمامی حساب ها باید در همان روز به شرکت پرداخت و تسویه شوند.
                در غیر این صورت، روز بعد شرکت موضوع را با مشتری هماهنگ کرده و مبلغ مستقیماً از مشتری دریافت خواهد شد.
            </p>
        </div>

        <div class="rule-item">
            <span>4️⃣</span>
            <p>
                <strong>هماهنگی با مشتری:</strong>
                پرسنل به هیچ وجه اجازه ندارند خودشان با مشتری زمان نظافت را تغییر دهند.
                در صورت بروز هرگونه مشکل یا تغییر شرایط، حتماً باید شرکت را در جریان بگذارند.
                حتی در صورتی که مشتری بخواهد کار را کنسل کند، پرسنل موظف اند موضوع را سریعاً به شرکت اطلاع دهند تا شرکت بتواند از کنسل شدن جلوگیری کند.
                در غیر این صورت، مسئولیت کامل بر عهده پرسنل خواهد بود.
            </p>
        </div>

        <div class="rule-item">
            <span>5️⃣</span>
            <p>
                <strong>ارتباط مستقیم مشتری با پرسنل:</strong>
                از آنجایی که مشتری بعد از اولین اعزام، شماره پرسنل را دارد، ممکن است اشتباه تماس بگیرد.
                در چنین شرایطی، پرسنل موظف اند قبل از هرگونه هماهنگی مستقیم با مشتری، شرکت را در جریان بگذارند تا شرکت هماهنگی لازم را انجام دهد و نفر را اعزام کند.
                در صورت هماهنگی مستقیم با مشتری بدون اطلاع به شرکت، بعد از آشکار شدن موضوع، هم درصد کار از پرسنل کسر خواهد شد و هم حجم کارهای محوله کاهش مییابد.
            </p>
        </div>

        <div class="rule-item">
            <span>6️⃣</span>
            <p>
                <strong>حضور به موقع:</strong>
                پرسنل موظف اند در زمان مقرر در محل کار حاضر شوند.
                تأخیر یا عدم حضور بدون اطلاع قبلی، تخلف محسوب شده و مشمول جریمه خواهد شد.
            </p>
        </div>

        <div class="rule-item">
            <span>7️⃣</span>
            <p>
                <strong>تحویل کار به مشتری:</strong>
                پرسنل موظف اند پس از پایان کار، نتیجه ی نظافت را به نماینده یا یکی از اعضای ساختمان تحویل دهند و تأیید بگیرند.
                در صورت عدم تحویل و بروز مشکل، پرسنل موظف به مراجعه مجدد و رفع ایراد خواهند بود.
                چنانچه پرسنل حاضر به مراجعه مجدد نشوند، شرکت نفر دیگری را اعزام خواهد کرد و معادل ساعات صرف شده برای رفع مشکل، از کارکرد پرسنل اول کسر و به نفر دوم پرداخت خواهد شد.
            </p>
        </div>

        <div class="rule-item">
            <span>8️⃣</span>
            <p>
                <strong>پرداخت درصد شرکت:</strong>
                پرسنل موظف است از کل مبلغ دریافتی به شرکت درصد بدهد (اعم از اضافه کاری).
            </p>
        </div>

        <div class="rule-item">
            <span>9️⃣</span>
            <p>
                <strong>کیفیت کار:</strong>
                کیفیت کار باید در حدی باشد که مشتری رضایت کامل داشته باشد و حتی به نام همان پرسنل، درخواست های بعدی ثبت شود.
                در صورتی که کیفیت کار باعث افزایش رضایت مشتری و معرفی مشتریان جدید شود، شرکت نیز اولویت بیشتری در معرفی کارهای بعدی برای آن پرسنل در نظر خواهد گرفت.
            </p>
        </div>

        <div class="rule-item">
            <span>🔟</span>
            <p>
                <strong>مرخصی:</strong>
                پرسنل در هر ماه حداکثر دو روز مرخصی دارند.
                همچنین روزهای جمعه به صورت یک هفته در میان مرخصی در نظر گرفته میشود.
                در صورت نیاز به مرخصی بیشتر، تنها در شرایط خاص و با ارائه مدرک موجه امکانپذیر است.
            </p>
        </div>

        <div class="rule-item">
            <span>1️⃣1️⃣</span>
            <p>
                <strong>حضور خانمها در محل کار:</strong>
                خانمها موظف اند فقط در کارهایی شرکت کنند که در محل، یک نفر خانم دیگر حضور داشته باشد.
                در غیر این صورت، باید به شرکت اطلاع دهند تا هماهنگی لازم انجام شود.
            </p>
        </div>

    </div>

    <div class="rules-confirm">

        <label class="rules-checkbox">
            <input type="checkbox" id="acceptRules">
            <span>
                تمام شرایط و قوانین همکاری شرکت را مطالعه کردم و میپذیرم.
            </span>
        </label>

        <button type="button" id="acceptRulesButton" class="accept-rules-button">
            تأیید و پذیرش قوانین
        </button>

        <p id="rulesConfirmResult" class="rules-confirm-result"></p>

    </div>

</section>

<section class="panel-section" id="announcementsSection">

    <div class="section-header">
        <span class="section-icon">📢</span>
        <div>
            <h3>اطلاعیه‌ها</h3>
            <p>آخرین اطلاعیه‌های شرکت</p>
        </div>
    </div>

    <div id="announcementsContainer">

        <div class="empty-state">
            <span>📢</span>
            <p>
                در حال حاضر اطلاعیه‌ای ثبت نشده است.
            </p>
        </div>

    </div>

</section>        <div class="worker-note">
            <span class="note-icon">🔔</span>

            <div>
                <strong>توجه</strong>

                <p>
                    اطلاعات این پنل فقط برای پرسنل ثبت‌شده شرکت قابل مشاهده است.
                </p>
            </div>
        </div>


    </main>


    <footer class="worker-footer">

        <div class="footer-company">
            شرکت خدماتی نظافتی تبریز انتخاب نیک
        </div>

        <div class="footer-address">
